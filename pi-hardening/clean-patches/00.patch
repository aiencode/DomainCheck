+const SAFE_REMOTE_MODEL_FIELDS = {
+	common: ["name", "input", "inputLimits", "cost"],
+	chat: [
+		"reasoning",
+		"thinkingLevelMap",
+		"promptCache",
+		"contextWindow",
+		"maxTokens",
+		"samplingParams",
+		"samplingParamsByThinkingLevel",
+	],
+	image: ["output"],
+	classifier: ["contextWindow"],
+} as const;
+
+function normalizeRouteBaseUrl(value: unknown): string | undefined {
+	if (typeof value !== "string") return undefined;
+	try {
+		const url = new URL(value);
+		url.hash = "";
+		return url.toString().replace(/\/+$/u, "");
+	} catch {
+		return value.replace(/\/+$/u, "");
+	}
+}
+
+function safeRemoteMetadata(model: AnyModel): Record<string, unknown> {
+	const source = model as unknown as Record<string, unknown>;
+	const result: Record<string, unknown> = {};
+	const fields = [...SAFE_REMOTE_MODEL_FIELDS.common, ...SAFE_REMOTE_MODEL_FIELDS[getModelType(model)]];
+	for (const field of fields) {
+		if (source[field] !== undefined) result[field] = source[field];
+	}
+	return result;
+}
+
+/**
+ * Remote catalogs are metadata overlays, not a routing authority.
+ *
+ * Existing built-in models keep their locally shipped route. New model IDs are
+ * accepted only when their type, API, and base URL match a route already shipped
+ * for that provider. Authentication headers, compatibility flags, and any future
+ * fields not explicitly allow-listed above always come from the trusted built-in
+ * template. The same policy is applied to cached catalogs before they are used.
+ */
+function hardenRemoteModels(provider: Provider, models: readonly AnyModel[]): AnyModel[] {
+	const trusted = provider.getAllModels?.() ?? provider.getModels();
+	return models.flatMap((remote) => {
+		if (remote.provider !== provider.id || typeof remote.id !== "string" || remote.id.length === 0) return [];
+		const type = getModelType(remote);
+		const sameId = trusted.find((model) => model.id === remote.id);
+		if (sameId && getModelType(sameId) !== type) return [];
+		const exact = sameId && getModelType(sameId) === type ? sameId : undefined;
+		const template =
+			exact ??
+			trusted.find(
+				(model) =>
+					getModelType(model) === type &&
+					model.api === remote.api &&
+					normalizeRouteBaseUrl(model.baseUrl) === normalizeRouteBaseUrl(remote.baseUrl),
+			);
+		if (!template) return [];
+
+		return [
+			{
+				...template,
+				id: remote.id,
+				...safeRemoteMetadata(remote),
+				provider: provider.id,
+				api: template.api,
+				baseUrl: template.baseUrl,
+				headers: template.headers,
+			} as AnyModel,
+		];
+	});
+}
